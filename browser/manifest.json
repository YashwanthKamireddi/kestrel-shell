{
  "manifest_version": 3,
  "name": "kestrel media",
  "version": "1.0",
  "description": "Tells the kestrel shell what this browser is playing (title, artist, cover, progress) and lets it control playback.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://*/*", "http://*/*"], "js": ["page.js"], "world": "MAIN", "run_at": "document_idle" },
    { "matches": ["https://*/*", "http://*/*"], "js": ["bridge.js"], "run_at": "document_idle" }
  ]
}
