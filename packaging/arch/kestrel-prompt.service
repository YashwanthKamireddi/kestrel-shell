[Unit]
Description=kestrel system prompts (passwords, Wi-Fi secrets, Bluetooth pairing)
# Its own process so a shell crash, freeze or restart never cancels a question being asked
# (docs/ROADMAP-v2.md, rule 3). kestrel.service sets KESTREL_SEPARATE_PROMPTS=1 and Wants= this
# unit, so the agents always have exactly one owner.
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/kestrel prompt
Restart=always
RestartSec=1
WatchdogSec=20
NotifyAccess=main
Slice=session.slice

[Install]
WantedBy=graphical-session.target
